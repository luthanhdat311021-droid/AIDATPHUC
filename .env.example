# Google Gemini API Key (Required for Multimodal PDF, Image, Video extraction)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Groq API Key (Required for Ultra-Fast Text Reasoning, JSON Study Generation, and Chat)
GROQ_API_KEY=your_groq_api_key_here

# Backend Port
PORT=5000

# Supabase Database (Persists Lesson History & Activity Logs)
SUPABASE_URL=https://your_supabase_project_url.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your_supabase_project_url.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# StudyMind Pro (chỉ đặt ở backend / Vercel, KHÔNG thêm tiền tố VITE_ — sẽ lộ ra trình duyệt)
# Service role key: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SePay: my.sepay.vn → Tích hợp WebHooks → Kiểu chứng thực "API Key"; URL: https://<domain>/api/sepay/webhook
SEPAY_WEBHOOK_API_KEY=a_long_random_secret
# Tài khoản nhận tiền đã liên kết với SePay (mặc định trong code: MBBank 0819883208; đặt để ghi đè)
# SEPAY_BANK_ACCOUNT=0819883208
# SEPAY_BANK_CODE=MBBank
# SEPAY_ACCOUNT_NAME=
