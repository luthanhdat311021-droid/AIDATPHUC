<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- text-xs font-bold text-slate-700 mb-1.5 -->
    <style name="AuthLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#334155</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- pl-10 py-3 bg-slate-50 border-slate-200 rounded-xl text-slate-900, icon on the left -->
    <style name="AuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
