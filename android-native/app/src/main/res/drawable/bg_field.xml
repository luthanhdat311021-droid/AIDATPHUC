<?xml version="1.0" encoding="utf-8"?>
<!-- Web inputs: bg-slate-50 border-slate-200 rounded-lg; focus:border-[#0F766E] -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/brand" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/slate_50" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
