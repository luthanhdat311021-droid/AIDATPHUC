# Example names only. Enter real values in the STAGING server secret store, never in the APK/repository.
REWARDS_ENABLED=false
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
REWARDS_STAGING_PROJECT_REF=
REWARDS_RPC_URL=
REWARDS_WALLET_XPUB=
REWARDS_OPERATOR_KEY=
REWARDS_WORKER_SECRET=
REWARDS_CONFIRMATIONS=64

# Local deployment/configuration scripts only (do not send deployer/vault secrets to Edge Functions).
REWARDS_TOKEN_ADDRESS=
REWARDS_DEPLOYER_KEY=
REWARDS_ADMIN_ADDRESS=
REWARDS_OPERATOR_ADDRESS=
STUDYMIND_VAULT_PASSWORD=
# Only for blockchain/scripts/admin.mjs (pause, operator rotation, admin hand-over); keep offline.
REWARDS_ADMIN_KEY=
# Set to true only when a NEW contract is intentionally planned; deploy.mjs refuses otherwise.
REWARDS_ALLOW_REDEPLOY=false
